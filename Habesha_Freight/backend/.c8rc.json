{
  "reporter": ["text", "html", "lcov"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/migrations/**",
    "**/seeds/**",
    "**/knexfile.ts",
    "**/testDatabase.ts",
    "**/types/**"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude-after-remap": false,
  "all": false,
  "check-coverage": false,
  "temp-directory": "./coverage/tmp",
  "reports-directory": "./coverage",
  "skip-full": false,
  "extension": [".ts"],
  "loader": "tsx"
}
