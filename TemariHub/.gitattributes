# TemariHub — normalize line endings

* text=auto eol=lf

# Shell scripts and git hooks must use LF (CRLF breaks them on macOS / CI)
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat binary assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.gz binary
