{
  "info": {
    "name": "TemariHub Diagnostic API",
    "description": "Login → start → questions → answer → complete.\n\nTest user (local):\n- phone: +251911000099\n- password: PostmanTest123!\n\nBase URL: http://127.0.0.1:8000/api/v1\nJWT lives under data.tokens.access (not access_token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api/v1" },
    { "key": "phone", "value": "+251911000099" },
    { "key": "password", "value": "PostmanTest123!" },
    { "key": "accessToken", "value": "" },
    { "key": "attemptId", "value": "" },
    { "key": "questionId", "value": "" },
    { "key": "selectedOptionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login ok', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success envelope', () => pm.expect(body.success).to.eql(true));",
              "const token = body.data && body.data.tokens && body.data.tokens.access;",
              "pm.expect(token).to.be.a('string');",
              "pm.collectionVariables.set('accessToken', token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login/"
      }
    },
    {
      "name": "2. Start diagnostic attempt",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('start 200 or 201', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "const body = pm.response.json();",
              "pm.test('success', () => pm.expect(body.success).to.eql(true));",
              "pm.collectionVariables.set('attemptId', body.data.id);",
              "console.log('attemptId', body.data.id, 'status', body.data.status);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/diagnostic/attempts/"
      }
    },
    {
      "name": "3. Get attempt detail",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/diagnostic/attempts/{{attemptId}}/"
      }
    },
    {
      "name": "4. List assigned questions",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('questions ok', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const items = body.data.items;",
              "pm.expect(items.length).to.be.above(0);",
              "pm.collectionVariables.set('questionId', items[0].id);",
              "pm.collectionVariables.set('selectedOptionId', items[0].options[0].id);",
              "console.log('questionId', items[0].id, 'option', items[0].options[0].id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/diagnostic/attempts/{{attemptId}}/questions/"
      }
    },
    {
      "name": "5. Submit answer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('answer 200 or 201', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "const body = pm.response.json();",
              "pm.test('success', () => pm.expect(body.success).to.eql(true));",
              "pm.test('no correctness leak', () => {",
              "  pm.expect(body.data).to.not.have.property('is_correct');",
              "  pm.expect(body.data).to.not.have.property('explanation');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"selected_option_id\": \"{{selectedOptionId}}\",\n  \"time_spent_seconds\": 12\n}"
        },
        "url": "{{baseUrl}}/diagnostic/attempts/{{attemptId}}/questions/{{questionId}}/answer/"
      }
    },
    {
      "name": "6. Complete attempt",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('complete 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('completed', () => pm.expect(body.data.status).to.eql('completed'));",
              "pm.test('has score', () => pm.expect(body.data.overall_score_pct).to.exist);",
              "console.log('score', body.data.overall_score_pct, 'answered', body.data.questions_answered);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/diagnostic/attempts/{{attemptId}}/complete/"
      }
    }
  ]
}
